# ADR-0004 phase 0. The management service cores, built by the module so that an application outside
# this repository enables them with Kconfig and ZEPHYR_EXTRA_MODULES, and does not compile Crux's source
# files into its own target. Access, the credential store and the security events are wired to each
# other (Access calls the store and the event provider, the store calls the event provider, and the
# events call Access), so one visible symbol builds the three. The service symbols select Thread, Sync
# and Time themselves (ADR-0004 C6), so that a product's configuration names service symbols only.
config CRUX_ACCESS
    bool "Crux Access with its credential store and security events (Experimental)"
    depends on CRUX_PILOT_MODULE && MULTITHREADING
    select CRUX_CREDENTIAL
    select CRUX_SECURITY_EVENT
    select CRUX_THREAD
    select CRUX_SYNC
    select CRUX_TIME
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image that leaves it off.

      Builds the Access core with its PSA Crypto and Time ports, the credential store with its Access
      store port, PSA ports and device ID, and the security events with their drain thread and the
      provider of Access's event port, and registers the three with the Zephyr link. It starts
      nothing, adds no crux:: target and no public header: the application writes the start
      sequence (docs/management-in-a-product.md), and reaches the public <crux/access.h> through its
      own include path until the composition interfaces of ADR-0004 phase 1a exist.

      The image needs the Mbed profile of PSA Crypto (CONFIG_PSA_CRYPTO_PROVIDER_MBEDTLS, with the
      locks of tests/native/management_composition/mbed-threading.conf, and the algorithms of
      profile-psa.conf), a Crux File provider for the store's two roots, Crux Logging for the events,
      and CONFIG_HWINFO for the device ID. The configuration refuses a missing profile, locks, File
      provider, Logging or HWINFO by name; a missing algorithm is not checked and fails at run time. No SSH provider and
      no other PSA profile is part of this symbol.

config CRUX_CREDENTIAL
    bool
    depends on CRUX_PILOT_MODULE
    help
      Experimental. The credential store of CONFIG_CRUX_ACCESS, selected by it. It has no prompt
      because the store cannot be linked without Access and the security events.

config CRUX_SECURITY_EVENT
    bool
    depends on CRUX_PILOT_MODULE
    help
      Experimental. The security events of CONFIG_CRUX_ACCESS, selected by it. It has no prompt
      because the events cannot be linked without Access and the credential store.

# ADR-0004 phase 0, slice 2: the Configuration service and the status service. Each needs Access and so
# selects nothing of it. Each selects the Crux symbols that it links itself (ADR-0004 C6): both use Sync,
# and the status service also reads Time.
config CRUX_CONFIG_SERVICE
    bool "Crux Configuration service (Experimental)"
    depends on CRUX_PILOT_MODULE && CRUX_ACCESS
    select CRUX_CONFIGURATION_CORE
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the Configuration service core and the provider of its event port over the security
      events, and the Configuration core beneath it. It starts nothing and adds no crux:: target and
      no public header: the application lists its parameters and calls crux_config_service_start().
      Without CONFIG_CRUX_CONFIGURATION_SETTINGS_FILE there is no save provider, a save returns
      CRUX_CONFIG_SERVICE_ERR_STORE with CRUX_CONFIG_ERR_NOT_SUPPORTED in the report's failed_result
      (the "no provider" port of components/configuration), and the service still reads and updates
      parameters in memory.

config CRUX_MGMT_STATUS
    bool "Crux status service (Experimental)"
    depends on CRUX_PILOT_MODULE && CRUX_ACCESS
    select CRUX_CONFIGURATION_CORE
    select CRUX_SYNC
    select CRUX_TIME
    help
      Experimental tier (ADR-0001 Decision 4): may change in any release, and the release notes list
      the change. Off by default, and nothing changes in an image that leaves it off.

      Builds the status service core and the sources of its items: System, Time, the network
      interface, the credential store and the security events. It needs Crux System and Crux Netif,
      and the configuration refuses an image without them by name. It starts nothing and adds no
      crux:: target and no public header: the application calls crux_mgmt_status_start().

config CRUX_CONFIGURATION_CORE
    bool
    depends on CRUX_PILOT_MODULE
    help
      Experimental. The Configuration core of CONFIG_CRUX_CONFIG_SERVICE and CONFIG_CRUX_MGMT_STATUS,
      selected by them, with no prompt. With CONFIG_CRUX_CONFIGURATION_SETTINGS_FILE it is that
      selection's copy that is linked, and this builds nothing.

menuconfig CRUX_SSH
    bool "Crux SSH management service on the wolfSSH provider"
    depends on CRUX_PILOT_MODULE && NETWORKING && NET_IPV4 && NET_SOCKETS && MULTITHREADING
    depends on WOLFSSH
    help
      Selects the wolfSSH provider behind the private provider interface, with the access adapter, and
      optionally the command line over SSH and SFTP. SSH has no public header and no crux:: target: a
      composition starts the provider itself, and provides the Access core, a host key, and the CLI
      core and file service that the two options below name. Only the Wolf profile can carry it: wolfSSH
      needs wolfSSL, and a build with CONFIG_MBEDTLS is refused at configuration. Without the
      crux-secure-management west group there is no wolfSSH, and the symbol cannot be set. See
      docs/ssh-wolf-provider.md and docs/ssh-integrated-image.md.

if CRUX_SSH

config CRUX_SSH_CLI
    bool "Command line over SSH, shell and exec"
    default y
    help
      Links the real CLI entry points. The composition then also links the CLI core and a provider of
      its event port, and calls crux_ssh_cli_set_provider(). Without this every shell and exec
      request is refused with exit status 255.

config CRUX_SSH_SFTP
    bool "SFTP, on the file service"
    default y
    help
      Links the real SFTP entry points and the wolfSSH file port. The composition then also links the
      file service. Without this every SFTP request is refused.

config CRUX_SSH_PORT
    int "Port of the SSH service, or 0 for an ephemeral one"
    default 22
    range 0 65535
    help
      Like the four symbols below it, this is read by the composition's own start code, which fills
      crux_ssh_config_t. The module's CMake does not apply it.

config CRUX_SSH_BIND_ADDRESS
    string "The one IPv4 address the SSH service listens on, or empty for every address"
    default ""
    help
      Dotted IPv4 text of a local address, which must already be on an interface when the service
      starts. Empty means every IPv4 address. Read by the composition's own start code, which
      passes it as crux_ssh_config_t.bind_address, NULL for an empty setting: the provider itself
      refuses an empty text, and any other text that is not an IPv4 address, so that a mistyped
      address never widens the listener. The RT1060-EVKB bench image sets the bench address (D10 of
      docs/rt1060-management-image-feasibility.md).

config CRUX_SSH_MAX_CONNECTIONS
    int "Connections at once, authenticated or not"
    default 4
    range 1 4
    help
      Each has a worker thread and a static stack. The provider's compile-time bound is 4.

config CRUX_SSH_MAX_AUTH_ATTEMPTS
    int "Failed attempts on one connection before it is closed"
    default 3
    range 1 255

config CRUX_SSH_AUTH_TIMEOUT_MS
    int "Time to log in, from accept"
    default 30000
    range 100 600000

config CRUX_SSH_IO_TIMEOUT_MS
    int "Longest that one read or write of a session waits"
    default 200
    range 10 60000

config CRUX_SSH_WORKER_STACK_BYTES
    int "Stack of each connection's worker thread"
    default 16384
    range 4096 65536
    help
      Not measured on a target: see docs/ssh-wolf-provider.md#resource-use and
      docs/ssh-integrated-image.md.

config CRUX_SSH_LISTENER_STACK_BYTES
    int "Stack of the listener thread"
    default 4096
    range 2048 32768

config CRUX_SSH_WORKER_PRIORITY
    int "Zephyr priority of every connection's worker thread, or -1 for the lowest application one"
    default -1
    range -1 NUM_PREEMPT_PRIORITIES
    help
      ADR-0002 P3. -1, the default, keeps today's K_LOWEST_APPLICATION_THREAD_PRIO, which is
      NUM_PREEMPT_PRIORITIES - 1 and so follows that setting. Otherwise a preemptive priority, 0 to
      NUM_PREEMPT_PRIORITIES - 1: the provider refuses the idle priority at compilation. The workers
      share this priority and a time slice. Read by crux_ssh_wolf_settings(). See
      docs/thread-sync.md#priority-map-of-crux-threads.

config CRUX_SSH_LISTENER_PRIORITY
    int "Zephyr priority of the listener thread, or -1 for the lowest application one"
    default -1
    range -1 NUM_PREEMPT_PRIORITIES
    help
      As CRUX_SSH_WORKER_PRIORITY, for the thread that accepts connections and starts their workers.

config CRUX_SSH_STACK_REPORT
    bool "Name the SSH threads and keep the lowest unused stack of the workers that ended"
    depends on THREAD_NAME && THREAD_STACK_INFO && INIT_STACKS
    help
      A measurement aid for an image that reads stack use on a target: the listener and each worker
      get a name ("ssh_listener", "ssh_worker"), and a worker that ends records how much of its
      stack it never touched, so that crux_ssh_wolf_worker_stack_ended() still has the figure after
      the thread is gone and its slot is used again. Costs a few dozen bytes and one stack scan when
      a worker ends. Off by default, and every other image is unchanged.

config CRUX_SSH_WINDOW_BYTES
    int "Channel window, which decides the heap of a logged-in session"
    default 16384
    range 4096 131072

endif # CRUX_SSH

# The two cookies and the X-Crux-Request of the attempt poll fit, with room for what else a device's
# address may carry. Sized in docs/web-contract.md, and each is checked when the adapter compiles.
configdefault HTTP_SERVER_VERSION_2
    default n if CRUX_WEB

configdefault HTTP_SERVER_MAX_HEADER_LEN
    default 512 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_COUNT
    default 7 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_BUFFER_SIZE
    default 1024 if CRUX_WEB

configdefault HTTP_SERVER_STACK_SIZE
    default 4096 if CRUX_WEB

# The server thread runs each TLS handshake inside accept, so a client that sends nothing stops every
# client for this long. Proposed from native_sim in docs/https-composition.md, until RT1060 evidence.
# It also bounds every outbound TLS connect in an image with CRUX_WEB.
configdefault NET_SOCKETS_TLS_CONNECT_TIMEOUT
    default 2000 if CRUX_WEB


