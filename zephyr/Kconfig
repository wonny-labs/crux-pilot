menuconfig CRUX_PILOT_MODULE
	bool "Crux Zephyr module"
	default y
	help
	  Enable discovery of Crux's Zephyr integration module.

if CRUX_PILOT_MODULE

config CRUX_TIME
	bool "Crux Time capability"
	default y if RTC
	help
	  Build typed monotonic clock access without requiring RTC hardware.
	  Realtime uses the native system clock and explicit authority adoption.

config CRUX_TIME_RTC
	bool "Crux optional native RTC source/storage adapter"
	depends on CRUX_TIME && RTC
	default n
	help
	  Explicit RTC read/store for trusted composition using the rtc alias.
	  Time init and system realtime never implicitly load or write RTC.

config CRUX_TIME_BUSY_WAIT
    bool "Crux Time native CPU busy-wait"
    depends on CRUX_TIME
    default n
    help
      Optional native busy-wait with provider range checks and no Crux locks,
      allocation or scheduler sleep. Disabled positive waits return NOT_SUPPORTED.
      ISR support requires provider/target validation. Unsupported enabled timer
      profiles fail configuration; no common numeric maximum is implied.

config CRUX_TIME_TESTING
	bool "Include Crux Time test controls"
	depends on ZTEST && CRUX_TIME
	default n
	help
	  Include private state-reset hooks for Crux Zephyr tests.

config CRUX_THREAD
	bool "Crux bounded joinable threads"
	depends on MULTITHREADING
	select TIMEOUT_64BIT
	select CRUX_TIME
	help
	  Component-owned bounded joinable threads using native kernel objects.

if CRUX_THREAD

config CRUX_THREAD_COUNT
	int "Thread worker slots"
	default 4
	range 1 64

config CRUX_THREAD_STACK_BYTES
	int "Minimum usable bytes per worker stack"
	default 4096
	range 1024 65536

endif # CRUX_THREAD

config CRUX_SYNC
	bool "Crux mutexes and counting semaphores"
	depends on MULTITHREADING
	select TIMEOUT_64BIT
	help
	  Component-owned mutexes and counting semaphores using native kernel objects.

if CRUX_SYNC

config CRUX_SYNC_MUTEX_COUNT
	int "Sync mutex slots"
	default 8
	range 1 64

config CRUX_SYNC_SEMAPHORE_COUNT
	int "Sync semaphore slots"
	default 8
	range 1 64

endif # CRUX_SYNC

endif # CRUX_PILOT_MODULE

config CRUX_SOCKETS
    bool "Crux qualified IPv4 client socket profile"
    depends on CRUX_PILOT_MODULE && NETWORKING && NET_IPV4 && NET_TCP && NET_UDP
    depends on POSIX_SYSTEM_INTERFACES && POSIX_NETWORKING && POSIX_DEVICE_IO
    depends on POSIX_FD_MGMT && POSIX_TIMERS && POSIX_MONOTONIC_CLOCK


config CRUX_NETIF
    bool "Crux primary interface status"
    depends on CRUX_PILOT_MODULE && NETWORKING && NET_IPV4

config CRUX_QUEUE
    bool "Crux bounded copy queue"
    depends on CRUX_PILOT_MODULE && MULTITHREADING
    select TIMEOUT_64BIT
    help
      Initial qualification profile: four queues, sixteen records, sixty-four bytes.

config CRUX_SERIAL
    bool "Crux bounded UART Serial"
    depends on CRUX_PILOT_MODULE && MULTITHREADING && SERIAL
    depends on UART_INTERRUPT_DRIVEN && UART_USE_RUNTIME_CONFIGURE
    select TIMEOUT_64BIT
    help
      One explicitly dedicated UART, 256-byte RX and TX buffers. Task context only.

config CRUX_CLI
    bool "Crux command line and serial console"
    depends on CRUX_PILOT_MODULE && CRUX_SERIAL && CRUX_THREAD
    help
      The command registry and the serial console over Crux Serial. Access and a provider of the
      event port have no Zephyr composition yet, so an image that calls it does not link.
      Without CRUX_DEVELOPMENT_IMAGE, an image with this has no Zephyr shell.

if CRUX_CLI

config CRUX_CLI_LINE_MAX
    int "Longest input line, in bytes before the line end"
    default 320
    range 301 4096
    help
      At least `config set <31-byte name> "<128-byte value>"` with every value byte escaped.

config CRUX_CLI_TOKENS_MAX
    int "Most tokens in a line, counting the command's words"
    default 10
    range 4 32

endif # CRUX_CLI

config CRUX_DEVELOPMENT_IMAGE
    bool "Mark this image as a development image"
    depends on CRUX_PILOT_MODULE
    help
      Opt-in. It allows the Zephyr shell, on its serial backend only, in an image that also has Crux
      management. No image may have a network shell backend or MCUMGR_GRP_SHELL, with or without
      this mark. A development image says so in its identifier and in its evidence, and it is never
      the subject of a production result.

config CRUX_I2C
    bool "Crux synchronous I2C transfers"
    depends on CRUX_PILOT_MODULE && I2C
    help
      Synchronous 7-bit I2C transfers through the composition-selected crux-i2c0 alias.

config CRUX_SPI
    bool "Crux synchronous SPI transceive"
    depends on CRUX_PILOT_MODULE && SPI
    help
      Synchronous full-duplex byte transceive through the composition-selected crux-spi0 alias.

config CRUX_LOGGING
    bool "Crux completed-text logging"
    depends on CRUX_PILOT_MODULE
    help
      Qualified native deferred UART backend; configuration is checked explicitly.

config CRUX_GPIO
    bool "Crux synchronous GPIO line"
    depends on CRUX_PILOT_MODULE && GPIO
    help
      One statically selected input line using the native GPIO driver.
      The required crux-gpio0 Devicetree alias is checked by the provider.

config CRUX_SYSTEM
    bool "Crux System observation, reset and single-owner watchdog"
    depends on CRUX_PILOT_MODULE && MULTITHREADING
    help
      Explicit native WATCHDOG/HWINFO/REBOOT composition required. No auto-arm,
      auto-clear, application health assessment, stop or reconfiguration.

config CRUX_FILE_SIMULATOR
    bool "Crux File VFS simulator candidate"
    depends on CRUX_PILOT_MODULE && BOARD_NATIVE_SIM && FLASH_SIMULATOR && FILE_SYSTEM
    help
      Experimental File provider for software-only storage validation.
      Does not select a target Flash layout, mount or format a volume.

config CRUX_FILE_FATFS_SIMULATOR
    bool "Crux File FatFs simulated-disk simulator candidate"
    depends on CRUX_PILOT_MODULE && BOARD_NATIVE_SIM && FAT_FILESYSTEM_ELM && FILE_SYSTEM
    depends on DISK_DRIVER_RAM || DISK_DRIVER_FLASH
    depends on FS_FATFS_LFN && FS_FATFS_MAX_LFN >= 127 && FS_FATFS_REENTRANT
    depends on !FS_FATFS_MOUNT_MKFS
    help
      Experimental native simulator composition on a RAM disk, or on a file-backed flash
      disk whose contents outlive the process; does not mount or format a volume.

config CRUX_FILE_FATFS_RT1060
    bool "Crux File FatFs provider on the RT1060-EVKB microSD"
    depends on CRUX_PILOT_MODULE && BOARD_MIMXRT1060_EVK && SOC_MIMXRT1062
    depends on BOARD_MIMXRT1060_EVK_MIMXRT1062_QSPI && BOARD_REVISION_B
    depends on FAT_FILESYSTEM_ELM && FILE_SYSTEM && DISK_DRIVER_SDMMC
    depends on DT_HAS_NXP_IMX_USDHC_ENABLED && DT_HAS_ZEPHYR_SDMMC_DISK_ENABLED
    depends on FS_FATFS_LFN && FS_FATFS_MAX_LFN >= 127 && FS_FATFS_REENTRANT
    depends on !FS_FATFS_MOUNT_MKFS
    help
      Link the File provider into an RT1060-EVKB image. Off by default. It mounts and
      formats nothing by itself; the project composition owns mount order and recovery.
      No physical-board result exists for this selection.

config CRUX_FILE_FATFS_RT1060_COMPILE_CHECK
    bool "Compile-only Crux File FatFs RT1060 SDHC check"
    depends on CRUX_PILOT_MODULE && BOARD_MIMXRT1060_EVK && SOC_MIMXRT1062
    depends on BOARD_MIMXRT1060_EVK_MIMXRT1062_QSPI && BOARD_REVISION_B
    depends on FAT_FILESYSTEM_ELM && FILE_SYSTEM && DISK_DRIVER_SDMMC
    depends on DT_HAS_NXP_IMX_USDHC_ENABLED && DT_HAS_ZEPHYR_SDMMC_DISK_ENABLED
    depends on FS_FATFS_LFN && FS_FATFS_MAX_LFN >= 127 && FS_FATFS_REENTRANT
    depends on !FS_FATFS_MOUNT_MKFS
    help
      Compile the File implementation and RT1060 SDHC/FatFs composition as an
      object-only check. This does not link or select a target File provider,
      mount media, format media, or enable runtime File operations.

# The USDHC HAL invalidates a read target by whole D-cache lines when a transfer completes, so the
# RT1060 selections take line-aligned targets only. file_native.c refuses a smaller SDHC value.
configdefault SDHC_BUFFER_ALIGNMENT
    default 32 if CRUX_FILE_FATFS_RT1060 || CRUX_FILE_FATFS_RT1060_COMPILE_CHECK

# Keeps the FatFs sector window out of the SD layer's bounce path.
configdefault FS_FATFS_WINDOW_ALIGNMENT
    default 32 if CRUX_FILE_FATFS_RT1060 || CRUX_FILE_FATFS_RT1060_COMPILE_CHECK

menuconfig CRUX_WEB
    bool "Crux web server adapter"
    depends on CRUX_PILOT_MODULE && NETWORKING
    select HTTP_SERVER
    select HTTP_SERVER_CAPTURE_HEADERS
    select HTTP_SERVER_RESOURCE_WILDCARD
    select HTTP_SERVER_COMPLETE_STATUS_PHRASES
    select NET_CONTEXT_SNDTIMEO if NET_NATIVE
    help
      The private adapter over the Zephyr HTTP server, for routes defined with crux/web.h. HTTPS
      only, unless a native_sim test asks otherwise. A composition starts it, and provides the
      Access core. See docs/web-contract.md.

if CRUX_WEB

config CRUX_WEB_PORT
    int "Port of the web service, or 0 for an ephemeral one"
    default 443
    range 0 65535

config CRUX_WEB_BACKLOG
    int "Connections the listening socket queues"
    default 4
    range 1 32

config CRUX_WEB_TLS_SEC_TAG
    int "TLS security tag of the service's credentials"
    default 1
    depends on !CRUX_WEB_PLAIN_HTTP_FOR_TESTS

config CRUX_WEB_BODY_BUFFER
    int "Bytes of request body held per client"
    default 1024
    range 64 16384

config CRUX_WEB_SEND_TIMEOUT_MS
    int "Longest wait of one socket send, on the server thread"
    default 250
    range 10 60000
    help
      A small response is about twenty sends in one callback, and each can wait this long while the
      server thread serves nobody else. A stall past the inactivity timer also closes other clients.

config CRUX_WEB_RESPONSE_PIECE
    int "Bytes of a response body passed to the server at a time"
    default 1024
    range 64 65536

config CRUX_WEB_RESPONSE_DEADLINE_MS
    int "Longest time one response may keep the server thread"
    default 3000
    range 10 600000

config CRUX_WEB_REQUEST_DEADLINE_MS
    int "Whole-request deadline, from the headers to the last body byte"
    default 5000
    range 10 600000
    help
      Every received byte restarts the server's inactivity timer, so that timer does not bound a
      client that trickles a body. A composition passes this in crux_web_config_t.

config CRUX_WEB_PLAIN_HTTP_FOR_TESTS
    bool "Plain HTTP on loopback, for tests of the adapter only"
    depends on BOARD_NATIVE_SIM
    help
      The design excludes plain HTTP. This exists so the adapter can run on native_sim before the
      TLS profiles of Issue #185 do, and no other board can select it.

endif # CRUX_WEB

# The two cookies and the X-Crux-Request of the attempt poll fit, with room for what else a device's
# address may carry. Sized in docs/web-contract.md, and each is checked when the adapter compiles.
configdefault HTTP_SERVER_VERSION_2
    default n if CRUX_WEB

configdefault HTTP_SERVER_MAX_HEADER_LEN
    default 512 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_COUNT
    default 7 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_BUFFER_SIZE
    default 1024 if CRUX_WEB

configdefault HTTP_SERVER_STACK_SIZE
    default 4096 if CRUX_WEB
