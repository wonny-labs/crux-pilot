config CRUX_FILE_RELIANCE_EDGE
    bool "Crux File provider on Reliance Edge"
    depends on CRUX_MODULE && CRUX_FS_RELIANCE_EDGE
    depends on !CRUX_FILE_SIMULATOR && !CRUX_FILE_FATFS_SIMULATOR
    depends on !CRUX_FILE_FATFS_RT1060 && !CRUX_FILE_FATFS_RT1060_COMPILE_CHECK
    depends on !CRUX_FILE_FATFS_RT1060_RAM_DISK
    help
      Link the File provider over the Reliance Edge file system of the Zephyr VFS. It
      works on any board that has the file system, and names are stored as they are, with no
      encoding. It mounts and formats nothing by itself; the composition owns the mount, the
      format and the recovery. The image links GPLv2 source, so it is for testing and is not
      distributed. No physical-board result exists for this selection.

config CRUX_FILE_POOL_SIZE
    int "Crux File open-handle pool size"
    depends on CRUX_MODULE
    range 4 32
    default 4
    help
      How many Crux File handles can be open at once in the image. A full pool makes
      crux_file_open return CRUX_FILE_ERR_NO_RESOURCES. The value is the public compile
      definition CRUX_FILE_POOL_SIZE of crux::file. Every user of File in the image shares the
      pool: the Access credential store takes one handle while it saves or reads a record, and
      the file service keeps its transfers below this value (CRUX_FILE_SERVICE_TRANSFER_MAX).
      The file system must hold every handle as well: on FatFs raise CONFIG_FS_FATFS_NUM_FILES
      to cover this value and any native files of the image, and with Reliance Edge
      CONFIG_CRUX_FS_RELIANCE_EDGE_HANDLE_COUNT must cover this value plus
      CONFIG_CRUX_FILE_DIR_POOL_SIZE (the build checks it). The Host build has the CMake cache
      variable CRUX_FILE_POOL_SIZE with the same default.

config CRUX_FILE_DIR_POOL_SIZE
    int "Crux File listing pool size"
    depends on CRUX_MODULE
    range 1 8
    default 2
    help
      How many Crux File listings can be open at once. A full pool makes crux_file_dir_open
      return CRUX_FILE_ERR_NO_RESOURCES. The value is the compile definition
      CRUX_FILE_DIR_POOL_SIZE of crux::file. On FatFs CONFIG_FS_FATFS_NUM_DIRS must cover it
      (the build checks it). The Host build has the CMake cache variable
      CRUX_FILE_DIR_POOL_SIZE with the same default.

# The USDHC HAL invalidates a read target by whole D-cache lines when a transfer completes, so the
# RT1060 selections and Reliance Edge take line-aligned targets only. With an SD host and a data
# cache, file_native.c refuses a value below the cache line size. With an SD host, the Reliance Edge
# adapter refuses a REDCONF_BUFFER_ALIGNMENT below this value.
configdefault SDHC_BUFFER_ALIGNMENT
    default 32 if CRUX_FILE_FATFS_RT1060 || CRUX_FILE_FATFS_RT1060_COMPILE_CHECK || \
                  CRUX_FILE_RELIANCE_EDGE

# Keeps the FatFs sector window out of the SD layer's bounce path.
configdefault FS_FATFS_WINDOW_ALIGNMENT
    default 32 if CRUX_FILE_FATFS_RT1060 || CRUX_FILE_FATFS_RT1060_COMPILE_CHECK

config CRUX_MMC_CACHE_FLUSH
    bool "Flush the eMMC cache on disk sync (build-local MMC stack correction)"
    depends on CRUX_MODULE && MMC_STACK
    default n
    help
      Replace subsys/sd/mmc.c in this build with a copy generated from
      patches/zephyr/mmc-cache-flush.patch. When the stack has turned the eMMC
      cache on, DISK_IOCTL_CTRL_SYNC sends FLUSH_CACHE and returns an error unless
      the card completes it. The Zephyr checkout is never edited, and a pinned
      source that differs from the expected one fails the configuration.

config CRUX_CONFIGURATION_SETTINGS_FILE
    bool "Crux Configuration on the Settings File backend over Reliance Edge"
    depends on CRUX_MODULE && CRUX_FS_RELIANCE_EDGE && SETTINGS_FILE
    help
      Link the Configuration component over the Zephyr Settings File backend, on the Reliance
      Edge file system only. The backend of the pinned Zephyr hides I/O faults, so the build
      stages corrected copies of three of its sources from
      tests/native/configuration_settings_file, and an image that selects this needs that
      directory. Settings are initialised by the composition, after its layout check:
      crux_config_zephyr_init lets the backend create the directories of
      CONFIG_SETTINGS_FILE_PATH, so the composition calls it only after its layout
      check has found the settings directory. Set CONFIG_SETTINGS_FILE_PATH under the
      volume's mount point.

menuconfig CRUX_WEB
    bool "Crux web server adapter"
    depends on CRUX_MODULE && NETWORKING
    select HTTP_SERVER
    select HTTP_SERVER_CAPTURE_HEADERS
    select HTTP_SERVER_RESOURCE_WILDCARD
    select HTTP_SERVER_COMPLETE_STATUS_PHRASES
    select NET_CONTEXT_SNDTIMEO if NET_NATIVE
    help
      The private adapter over the Zephyr HTTP server, for routes defined with crux/web.h. HTTPS
      only, unless a native_sim test asks otherwise. A composition starts it, and provides the
      Access core. The module defines the composition target crux::web_zephyr for
      <crux/web_zephyr.h> (Experimental), which declares crux_web_start(): a composition
      interface, not a portable usage target, and a native-free consumer is rejected if it links
      it. See docs/web-contract.md.

if CRUX_WEB

config CRUX_WEB_PORT
    int "Port of the web service, or 0 for an ephemeral one"
    default 443
    range 0 65535

config CRUX_WEB_BIND_ADDRESS
    string "The one address the web service listens on, or empty for every address"
    default ""
    help
      Dotted IPv4 text of a local address (or IPv6 text, with IPv6 enabled), which must already be
      on an interface when the service starts. Empty keeps the Zephyr server's default: every
      address, and IPv6 as well when it is enabled. The RT1060-EVKB bench image sets the bench
      address (D10 of docs/rt1060-management-image-feasibility.md). The Zephyr server falls back to
      every address for a text that is not an address of an enabled family, so crux_web_start()
      returns CRUX_WEB_ERR_FAILED for such a text and the server does not start. The plain HTTP test
      build takes it too, so that tests/native/web_http can check both.

config CRUX_WEB_BACKLOG
    int "Connections the listening socket queues"
    default 4
    range 1 32

config CRUX_WEB_TLS_SEC_TAG
    int "TLS security tag of the service's credentials"
    default 1
    depends on !CRUX_WEB_PLAIN_HTTP_FOR_TESTS

config CRUX_WEB_BODY_BUFFER
    int "Bytes of request body held per client"
    default 1024
    range 64 16384

config CRUX_WEB_SEND_TIMEOUT_MS
    int "Longest wait of one socket send, on the server thread"
    default 250
    range 10 60000
    help
      A small response is about twenty sends in one callback, and each can wait this long while the
      server thread serves nobody else. A stall past the inactivity timer also closes other clients.

config CRUX_WEB_RESPONSE_PIECE
    int "Bytes of a response body passed to the server at a time"
    default 1024
    range 64 65536

config CRUX_WEB_RESPONSE_DEADLINE_MS
    int "Longest time one response may keep the server thread"
    default 3000
    range 10 600000

config CRUX_WEB_REQUEST_DEADLINE_MS
    int "Whole-request deadline, from the headers to the last body byte"
    default 5000
    range 10 600000
    help
      Every received byte restarts the server's inactivity timer, so that timer does not bound a
      client that trickles a body. A composition passes this in crux_web_config_t.

config CRUX_WEB_HEADER_DEADLINE_MS
    int "Longest time from a request's first byte to the end of its headers"
    default 10000
    range 100 600000
    help
      Every received byte restarts the Zephyr server's inactivity timer, and headers run no
      callback, so without this a client that trickles an incomplete request head holds a client
      slot for as long as the parser accepts headers. The web adapter builds the server with a
      build-local patch (patches/zephyr/http-header-deadline.patch) that closes such a client this
      long after the request's first byte, whatever it sends meanwhile. A client idle between
      requests stays under the inactivity timer, and the body of a request that reaches a route
      under CONFIG_CRUX_WEB_REQUEST_DEADLINE_MS. The default is one period of the server's default
      inactivity timeout of 10 s (Issue #268). Two limits remain: a client that reconnects holds a
      slot for up to this long per connection, and a body trickled after a plain 404 or 405 that the
      server sends itself runs no callback and has no time limit (Issue #529).

config CRUX_WEB_PLAIN_HTTP_FOR_TESTS
    bool "Plain HTTP on loopback, for tests of the adapter only"
    depends on BOARD_NATIVE_SIM
    help
      The design excludes plain HTTP. This exists so the adapter can run on native_sim before the
      TLS profiles of Issue #185 do, and no other board can select it.

endif # CRUX_WEB

# The locks that the Mbed profile's PSA core needs once Access, the credential store and TLS threads
# share it. Zephyr's module offers no option for them at the pinned revision, so the module provides them.
config CRUX_PSA_THREADING
    bool "Locks for TF-PSA-Crypto's core on Zephyr kernel objects (Experimental)"
    depends on CRUX_MODULE && MULTITHREADING && PSA_CRYPTO_PROVIDER_MBEDTLS
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and no behaviour changes in an
      image that leaves it off, including every image on the Wolf profile (the symbol depends on the
      Mbed provider, and nothing selects or implies it). The module also defines
      CONFIG_TF_PSA_CRYPTO_USER_CONFIG_FILE as a string whose default applies only when this option
      is on. In an image without the Mbed TLS module that symbol has no prompt and no active
      default, so it is not written to .config, and nothing reads it.

      Turns on MBEDTLS_THREADING_C and MBEDTLS_THREADING_ALT in TF-PSA-Crypto's user configuration
      and builds the locks of the core on k_mutex and k_condvar. They are registered at POST_KERNEL
      priority 0, before the module's own PSA start, so the core is locked before anything uses it.
      CONFIG_CRUX_ACCESS refuses an Mbed profile image without them (or without a lock provider of
      the product's own, set through CONFIG_TF_PSA_CRYPTO_USER_CONFIG_FILE). The option sets that
      file name to the module's own header, so a product that sets another file keeps its own locks
      and leaves this option off; setting both is refused at configuration.

      The locks show no absence of a race: no case exercises a concurrent use of the core
      (docs/psa-crypto-qualification.md).

# The Mbed TLS module defines this symbol, and it is not in the default workspace (the crux-secure-management group is
# off by default). Without a type here, the definition below would be an untyped symbol there, which kconfig.py rejects
# as an error, and configdefault does not help: it adds a default to a symbol and still leaves one that no module
# defines untyped. With the Mbed TLS module the two definitions agree on the type. The symbol then exists, empty, in an
# image without that module, and nothing reads it there: CONFIG_CRUX_PSA_THREADING depends on the Mbed provider.
config TF_PSA_CRYPTO_USER_CONFIG_FILE
    string
    default "crux_tf_psa_user_config.h" if CRUX_PSA_THREADING

# ADR-0004 phase 0. The management service cores, built by the module so that an application outside
# this repository enables them with Kconfig and ZEPHYR_EXTRA_MODULES, and does not compile Crux's source
# files into its own target. Access, the credential store and the security events are wired to each
# other (Access calls the store and the event provider, the store calls the event provider, and the
# events call Access), so one visible symbol builds the three. The service symbols select Thread, Sync
# and Time themselves (ADR-0004 C6), so that a product's configuration names service symbols only.
config CRUX_ACCESS
    bool "Crux Access with its credential store and security events (Experimental)"
    depends on CRUX_MODULE && MULTITHREADING
    select CRUX_CREDENTIAL
    select CRUX_SECURITY_EVENT
    select CRUX_THREAD
    select CRUX_SYNC
    select CRUX_TIME
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image that leaves it off.

      Builds the Access core with its PSA Crypto and Time ports, the credential store with its Access
      store port, PSA ports and device ID, and the security events with their drain thread and the
      provider of Access's event port, and registers the three with the Zephyr link. It starts
      nothing: the application writes the start sequence (docs/management-in-a-product.md). It links
      the portable targets crux::access, crux::credential_store and crux::security_event for their
      public headers (Experimental).

      The image needs the Mbed profile of PSA Crypto (CONFIG_PSA_CRYPTO_PROVIDER_MBEDTLS, with the
      locks of CONFIG_CRUX_PSA_THREADING, and the algorithms of profile-psa.conf), a Crux File
      provider for the store's two roots, Crux Logging for the events, and CONFIG_HWINFO for the
      device ID. The configuration refuses a missing profile, locks, File
      provider, Logging or HWINFO by name; a missing algorithm is not checked and fails at run time. No SSH provider and
      no other PSA profile is part of this symbol.

config CRUX_CREDENTIAL
    bool
    depends on CRUX_MODULE
    help
      Experimental. The credential store of CONFIG_CRUX_ACCESS, selected by it. It has no prompt
      because the store cannot be linked without Access and the security events.

config CRUX_SECURITY_EVENT
    bool
    depends on CRUX_MODULE
    help
      Experimental. The security events of CONFIG_CRUX_ACCESS, selected by it. It has no prompt
      because the events cannot be linked without Access and the credential store.

# ADR-0004 phase 0, slice 2: the Configuration service and the status service. Each needs Access and so
# selects nothing of it. Each selects the Crux symbols that it links itself (ADR-0004 C6): both use Sync,
# and the status service also reads Time.
config CRUX_CONFIG_SERVICE
    bool "Crux Configuration service (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS
    select CRUX_CONFIGURATION_CORE
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the Configuration service core and the provider of its event port over the security
      events, and the Configuration core beneath it. It starts nothing: the application lists its
      parameters and calls crux_config_service_start(). The module defines the portable target
      crux::config_service for <crux/config_service.h> (Experimental).
      Without CONFIG_CRUX_CONFIGURATION_SETTINGS_FILE there is no save provider, a save returns
      CRUX_CONFIG_SERVICE_ERR_STORE with CRUX_CONFIG_ERR_NOT_SUPPORTED in the report's failed_result
      (the "no provider" port of components/configuration), and the service still reads and updates
      parameters in memory.

config CRUX_MGMT_STATUS
    bool "Crux status service (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS
    select CRUX_CONFIGURATION_CORE
    select CRUX_SYNC
    select CRUX_TIME
    help
      Experimental tier (ADR-0001 Decision 4): may change in any release, and the release notes list
      the change. Off by default, and nothing changes in an image that leaves it off.

      Builds the status service core and the sources of its items: System, Time, the network
      interface, the credential store and the security events. It needs Crux System and Crux Netif,
      and the configuration refuses an image without them by name. It starts nothing: the application
      calls crux_mgmt_status_start(). The module defines the portable target crux::mgmt_status for
      <crux/management_status.h> (Experimental).

config CRUX_CONFIGURATION_CORE
    bool
    depends on CRUX_MODULE
    help
      Experimental. The Configuration core of CONFIG_CRUX_CONFIG_SERVICE, CONFIG_CRUX_MGMT_STATUS and
      CONFIG_CRUX_REBOOT, selected by them, with no prompt. With CONFIG_CRUX_CONFIGURATION_SETTINGS_FILE it is that
      selection's copy that is linked, and this builds nothing. Either way the module defines the
      portable target crux::configuration for <crux/configuration.h>.

# ADR-0004 phase 0, slice 3: network settings, the TLS certificate module, the file service and reboot. Each
# needs Access, and the network settings service also needs the Configuration service. Each selects the
# Crux symbols that it links (ADR-0004 C6).
config CRUX_NETWORK_SETTINGS
    bool "Crux network settings service (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS && CRUX_CONFIG_SERVICE
    select CRUX_THREAD
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the network settings service core, its check and the provider of its event port. The
      apply port is the application's (ADR-0004 C3): an application that applies settings to an
      interface implements crux_network_settings_port_apply() and crux_network_settings_port_running()
      declared in <crux/network_settings_apply_port.h> (Experimental), and an image without them does
      not link, unless CONFIG_CRUX_NETWORK_SETTINGS_NO_APPLY is set. It starts nothing and builds no
      serial command. The module defines the portable target crux::network_settings for
      <crux/network_settings.h> (Experimental).

config CRUX_NETWORK_SETTINGS_NO_APPLY
    bool "Network settings apply port that applies nothing (Experimental)"
    depends on CRUX_NETWORK_SETTINGS
    help
      Experimental. Builds the no-op apply port of components/network_settings: it reports that it
      applied nothing, so the boot report reads applied false and source default, and it reports no
      running values, so GET shows none. For native_sim and for an
      image whose application applies nothing. Do not set it in an image that implements the apply port
      itself: the two would define the same symbols twice.

config CRUX_TLS_CERTIFICATE
    bool "Crux TLS certificate module (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the TLS certificate module, its X.509 encoder, its PSA Crypto ports and the provider of its
      event port. It keeps the certificate and the device key in the credential store of CONFIG_CRUX_ACCESS.
      It registers nothing with Zephyr's TLS credentials: the application takes the material and calls
      tls_credential_add itself (ADR-0004 C4), so the key's bytes pass through application code. It
      starts nothing: the application starts the module. It defines the portable target
      crux::tls_certificate for <crux/tls_certificate.h> and <crux/tls_certificate_start.h>, the
      header that carries the key (Experimental).

config CRUX_FILE_SERVICE
    bool "Crux file service (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the file service core and the provider of its event port. It reaches files through the Crux
      File provider that CONFIG_CRUX_ACCESS already needs. It starts nothing: the application declares its
      areas and calls crux_file_service_start(). The module defines the portable target
      crux::file_service for <crux/file_service.h> (Experimental).

config CRUX_REBOOT
    bool "Crux reboot service (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS
    select CRUX_CONFIGURATION_CORE
    select CRUX_THREAD
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds the reboot service core and its sleep, both over Zephyr kernel objects, its reset over
      crux_system_reset() and the providers of its event port. It needs Crux System (CONFIG_CRUX_SYSTEM), and the configuration
      refuses an image without it by name. The restart policy is the application's: crux_reboot_start()
      refuses a configuration that states none. It starts nothing. The module defines the portable
      target crux::reboot for <crux/reboot.h> (Experimental).

# ADR-0004 phase 0, slice 4: the web session and web management cores. The routes stay the application's:
# it names the route sources it wants to crux_web_routes(), as before. Each selects the Crux symbols that it
# links (ADR-0004 C6).
config CRUX_WEB_SESSION
    bool "Crux web sessions (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS && CRUX_WEB
    select CRUX_THREAD
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): the symbol, and what it builds, may change in any
      release, and the release notes list the change. Off by default, and nothing changes in an image
      that leaves it off.

      Builds login, sessions and request forgery protection, with the password verification port over
      PSA Crypto. The login and logout routes are not built here: the application names
      CRUX_WEB_SESSION_ROUTES of components/web/session/sources.cmake to crux_web_routes(), so a route
      that is not named is not in the table. It starts nothing: the application calls
      crux_web_session_init() and starts the worker. The module defines the portable target
      crux::web_session for <crux/web_session.h> (Experimental), ordinary service API and not a
      composition interface.

config CRUX_WEB_MANAGEMENT
    bool "Crux web management (Experimental)"
    depends on CRUX_MODULE && CRUX_ACCESS && CRUX_WEB_SESSION && CRUX_CONFIG_SERVICE && CRUX_MGMT_STATUS
    select CRUX_THREAD
    select CRUX_SYNC
    help
      Experimental tier (ADR-0001 Decision 4): may change in any release, and the release notes list the
      change. Off by default, and nothing changes in an image that leaves it off.

      Builds the JSON of the status and configuration routes and the save worker, and, with
      CONFIG_CRUX_NETWORK_SETTINGS, the JSON of the network routes. The routes are not built here: the
      application names the CRUX_WEB_MANAGEMENT_*_ROUTES sources that it wants to crux_web_routes(). It
      starts nothing. The module defines the portable target crux::web_management for
      <crux/web_management.h> (Experimental), ordinary service API and not a composition interface.

menuconfig CRUX_SSH
    bool "Crux SSH management service on the wolfSSH provider"
    depends on CRUX_MODULE && NETWORKING && NET_IPV4 && NET_SOCKETS && MULTITHREADING
    depends on WOLFSSH
    help
      Selects the wolfSSH provider behind the private provider interface, with the access adapter, and
      optionally the command line over SSH and SFTP. SSH has no public header and no crux:: target: a
      composition starts the provider itself, and provides the Access core, a host key, and the CLI
      core and file service that the two options below name. Only the Wolf profile can carry it: wolfSSH
      needs wolfSSL, and a build with CONFIG_MBEDTLS is refused at configuration. Without the
      crux-secure-management west group there is no wolfSSH, and the symbol cannot be set. The access
      adapter reports its two security events through the event core, so an image with this symbol must
      also link the security event core, or it does not link. CONFIG_CRUX_ACCESS builds it, and this
      symbol does not select it. See docs/ssh-wolf-provider.md and docs/ssh-integrated-image.md.

if CRUX_SSH

config CRUX_SSH_CLI
    bool "Command line over SSH, shell and exec"
    default y
    help
      Links the real CLI entry points. The composition then also links the CLI core and a provider of
      its event port, and calls crux_ssh_cli_set_provider(). Without this every shell and exec
      request is refused with exit status 255.

config CRUX_SSH_SFTP
    bool "SFTP, on the file service"
    default y
    help
      Links the real SFTP entry points and the wolfSSH file port. The composition then also links the
      file service. Without this every SFTP request is refused.

config CRUX_SSH_PORT
    int "Port of the SSH service, or 0 for an ephemeral one"
    default 22
    range 0 65535
    help
      Like the four symbols below it, this is read by the composition's own start code, which fills
      crux_ssh_config_t. The module's CMake does not apply it.

config CRUX_SSH_BIND_ADDRESS
    string "The one IPv4 address the SSH service listens on, or empty for every address"
    default ""
    help
      Dotted IPv4 text of a local address, which must already be on an interface when the service
      starts. Empty means every IPv4 address. Read by the composition's own start code, which
      passes it as crux_ssh_config_t.bind_address, NULL for an empty setting: the provider itself
      refuses an empty text, and any other text that is not an IPv4 address, so that a mistyped
      address never widens the listener. The RT1060-EVKB bench image sets the bench address (D10 of
      docs/rt1060-management-image-feasibility.md).

config CRUX_SSH_MAX_CONNECTIONS
    int "Connections at once, authenticated or not"
    default 4
    range 1 4
    help
      Each has a worker thread and a static stack. The provider's compile-time bound is 4.

config CRUX_SSH_MAX_AUTH_ATTEMPTS
    int "Failed attempts on one connection before it is closed"
    default 3
    range 1 255

config CRUX_SSH_AUTH_TIMEOUT_MS
    int "Time to log in, from accept"
    default 30000
    range 100 600000

config CRUX_SSH_IO_TIMEOUT_MS
    int "Longest that one read or write of a session waits"
    default 200
    range 10 60000

config CRUX_SSH_WORKER_STACK_BYTES
    int "Stack of each connection's worker thread"
    default 16384
    range 4096 65536
    help
      Not measured on a target: see docs/ssh-wolf-provider.md#resource-use and
      docs/ssh-integrated-image.md.

config CRUX_SSH_LISTENER_STACK_BYTES
    int "Stack of the listener thread"
    default 4096
    range 2048 32768

config CRUX_SSH_WORKER_PRIORITY
    int "Zephyr priority of every connection's worker thread, or -1 for the lowest application one"
    default -1
    range -1 NUM_PREEMPT_PRIORITIES
    help
      ADR-0002 P3. -1, the default, keeps today's K_LOWEST_APPLICATION_THREAD_PRIO, which is
      NUM_PREEMPT_PRIORITIES - 1 and so follows that setting. Otherwise a preemptive priority, 0 to
      NUM_PREEMPT_PRIORITIES - 1: the provider refuses the idle priority at compilation. The workers
      share this priority and a time slice. Read by crux_ssh_wolf_settings(). See
      docs/thread-sync.md#priority-map-of-crux-threads.

config CRUX_SSH_LISTENER_PRIORITY
    int "Zephyr priority of the listener thread, or -1 for the lowest application one"
    default -1
    range -1 NUM_PREEMPT_PRIORITIES
    help
      As CRUX_SSH_WORKER_PRIORITY, for the thread that accepts connections and starts their workers.

config CRUX_SSH_STACK_REPORT
    bool "Name the SSH threads and keep the lowest unused stack of the workers that ended"
    depends on THREAD_NAME && THREAD_STACK_INFO && INIT_STACKS
    help
      A measurement aid for an image that reads stack use on a target: the listener and each worker
      get a name ("ssh_listener", "ssh_worker"), and a worker that ends records how much of its
      stack it never touched, so that crux_ssh_wolf_worker_stack_ended() still has the figure after
      the thread is gone and its slot is used again. Costs a few dozen bytes and one stack scan when
      a worker ends. Off by default, and every other image is unchanged.

config CRUX_SSH_WINDOW_BYTES
    int "Channel window, which decides the heap of a logged-in session"
    default 16384
    range 4096 131072

endif # CRUX_SSH

# The two cookies and the X-Crux-Request of the attempt poll fit, with room for what else a device's
# address may carry. Sized in docs/web-contract.md, and each is checked when the adapter compiles.
configdefault HTTP_SERVER_VERSION_2
    default n if CRUX_WEB

configdefault HTTP_SERVER_MAX_HEADER_LEN
    default 512 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_COUNT
    default 7 if CRUX_WEB

configdefault HTTP_SERVER_CAPTURE_HEADER_BUFFER_SIZE
    default 1024 if CRUX_WEB

configdefault HTTP_SERVER_STACK_SIZE
    default 4096 if CRUX_WEB

# The server thread runs each TLS handshake inside accept, so a client that sends nothing stops every
# client for this long. Proposed from native_sim in docs/https-composition.md, until RT1060 evidence.
# It also bounds every outbound TLS connect in an image with CRUX_WEB.
configdefault NET_SOCKETS_TLS_CONNECT_TIMEOUT
    default 2000 if CRUX_WEB


