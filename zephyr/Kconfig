menuconfig CRUX_PILOT_MODULE
	bool "Crux Zephyr module"
	default y
	help
	  Enable discovery of Crux's Zephyr integration module.

if CRUX_PILOT_MODULE

config CRUX_TIME
	bool "Crux Time capability"
	depends on RTC
	default y
	help
	  Build the Crux Time common implementation and selected Zephyr RTC provider.

config CRUX_TIME_TESTING
	bool "Include Crux Time test controls"
	depends on ZTEST && CRUX_TIME
	default n
	help
	  Include private state-reset hooks for Crux Zephyr tests.

config CRUX_EXECUTION
	bool "Crux portable execution capability"
	depends on MULTITHREADING
	select TIMEOUT_64BIT
	help
	  Bounded joinable threads, nonrecursive mutexes and counting semaphores.
	  Providers use native kernel objects; consumers use only the portable contract.

if CRUX_EXECUTION

config CRUX_EXECUTION_THREAD_COUNT
	int "Execution worker slots"
	default 4
	range 1 64

config CRUX_EXECUTION_MUTEX_COUNT
	int "Execution mutex slots"
	default 8
	range 1 64

config CRUX_EXECUTION_SEMAPHORE_COUNT
	int "Execution semaphore slots"
	default 8
	range 1 64

config CRUX_EXECUTION_STACK_BYTES
	int "Minimum usable bytes per worker stack"
	default 4096
	range 1024 65536

endif # CRUX_EXECUTION

endif # CRUX_PILOT_MODULE
