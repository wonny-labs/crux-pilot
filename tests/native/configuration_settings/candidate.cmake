set(_copy "${CMAKE_BINARY_DIR}/configuration-candidate")
execute_process(COMMAND ${PYTHON_EXECUTABLE} ${CMAKE_CURRENT_LIST_DIR}/prepare.py
  --zephyr ${ZEPHYR_BASE} --output ${_copy} RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "Pinned Settings/NVS copy preparation failed")
endif()
get_target_property(_sources zephyr SOURCES)
foreach(_relative IN ITEMS subsys/settings/src/settings_store.c subsys/settings/src/settings_nvs.c subsys/kvss/nvs/nvs.c)
  set(_original "${ZEPHYR_BASE}/${_relative}")
  set(_count 0)
  foreach(_source IN LISTS _sources)
    if(_source STREQUAL _original)
      math(EXPR _count "${_count} + 1")
    endif()
  endforeach()
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original source: ${_original}")
  endif()
  get_filename_component(_name ${_relative} NAME)
  list(REMOVE_ITEM _sources "${_original}")
  if(_name STREQUAL "nvs.c")
    list(APPEND _sources "${_copy}/nvs/nvs.c")
  else()
    list(APPEND _sources "${_copy}/${_name}")
  endif()
endforeach()
set_property(TARGET zephyr PROPERTY SOURCES "${_sources}")
target_include_directories(zephyr PRIVATE ${ZEPHYR_BASE}/subsys/kvss/nvs ${ZEPHYR_BASE}/subsys/settings/src)
