rsource "../../support/emmc_sim/Kconfig"

# The sample's setting, which emmc_storage.c reads; the fixture takes the default. It repeats
# samples/storage_emmc/Kconfig because the test compiles that source but not that Kconfig, and
# app.overlay names the same disk "MMC": change the default in all three places together.
config SAMPLE_EMMC_DISK_NAME
	string "Disk name of the eMMC"
	default "MMC"

config EMMC_COMPOSITION_TEST_INIT_FAILURE
	bool "Run only the card initialisation failure case"
	help
	  A failed disk init is only a fresh init if no earlier case initialised the disk, so this
	  case is a scenario of its own, and the other cases skip themselves in it.

source "Kconfig.zephyr"
