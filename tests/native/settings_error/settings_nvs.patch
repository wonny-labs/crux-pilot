+/* Validate before appending a terminator. A stored name may include its final NUL. */
+static int settings_nvs_name_validate(char *name, ssize_t length, size_t capacity)
+{
+	if (length <= 0 || (size_t)length >= capacity) {
+		return -EBADMSG;
+	}
+	if (name[0] == '\0' || memchr(name, '\0', (size_t)length - 1) != NULL) {
+		return -EBADMSG;
+	}
+	name[length] = '\0';
+	return 0;
+}
+
+/* Only publish the repaired count after NVS acknowledges the write. */
+static int settings_nvs_count_decrement(struct settings_nvs *cf, uint16_t name_id)
+{
+	uint16_t last_name_id = name_id - 1;
+	ssize_t rc;
+
+	if (name_id != cf->last_name_id) {
+		return 0;
+	}
+	rc = nvs_write(&cf->cf_nvs, NVS_NAMECNT_ID, &last_name_id, sizeof(last_name_id));
+	if (rc < 0) {
+		return rc;
+	}
+	cf->last_name_id = last_name_id;
+	return 0;
+}
+
