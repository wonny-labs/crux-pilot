+/* Candidate scope: cache-disabled direct traversal and save_one. */
+static int settings_nvs_name_validate(char *name, ssize_t length, size_t capacity)
+{
+	if (length <= 0 || (size_t)length >= capacity || name[0] == '\0' ||
+	    memchr(name, '\0', (size_t)length - 1) != NULL) {
+		return -EBADMSG;
+	}
+	name[length] = '\0';
+	return 0;
+}
+
+/* A completely absent pair is a valid deletion hole. Never repair on read. */
+static int settings_nvs_pair_validate(struct settings_nvs *cf, uint16_t id,
+				      char *name, size_t capacity)
+{
+	char value;
+	ssize_t nr = nvs_read(&cf->cf_nvs, id, name, capacity);
+	ssize_t vr;
+	int rc;
+
+	if (nr < 0 && nr != -ENOENT) {
+		return nr;
+	}
+	if (nr != -ENOENT) {
+		rc = settings_nvs_name_validate(name, nr, capacity);
+		if (rc) {
+			return rc;
+		}
+	}
+	vr = nvs_read(&cf->cf_nvs, id + NVS_NAME_ID_OFFSET, &value, sizeof(value));
+	if (vr < 0 && vr != -ENOENT) {
+		return vr;
+	}
+	if (nr == -ENOENT && vr == -ENOENT) {
+		return 0;
+	}
+	if (nr == -ENOENT || vr <= 0) {
+		return -EBADMSG;
+	}
+	return (int)vr;
+}
+
+/* Validate ownership over the claimed ID range before save has side effects.
+ * One-byte value probes establish presence, not full-value CRC integrity.
+ */
+static int settings_nvs_save_preflight(struct settings_nvs *cf)
+{
+	char name[SETTINGS_MAX_NAME_LEN + SETTINGS_EXTRA_LEN + 1];
+	uint16_t id = cf->last_name_id;
+
+	while (id > NVS_NAMECNT_ID) {
+		int rc = settings_nvs_pair_validate(cf, id, name, sizeof(name));
+
+		if (rc < 0) {
+			return rc;
+		}
+		id--;
+	}
+	return 0;
+}
