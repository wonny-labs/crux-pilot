# Test-only hook, also usable as CMAKE_PROJECT_INCLUDE for upstream regressions.
if(NOT CRUX_NVS_STARTUP_CANDIDATE OR NOT TARGET zephyr OR NOT CONFIG_NVS)
  return()
endif()
get_property(_already GLOBAL PROPERTY CRUX_NVS_STARTUP_REPLACED)
if(_already)
  return()
endif()
get_target_property(_sources zephyr SOURCES)
set(_original "${ZEPHYR_BASE}/subsys/kvss/nvs/nvs.c")
list(FIND _sources "${_original}" _index)
if(_index LESS 0)
  message(FATAL_ERROR "Expected exactly one original NVS source on Zephyr target")
endif()
set(_count 0)
foreach(_source IN LISTS _sources)
  if(_source STREQUAL _original)
    math(EXPR _count "${_count} + 1")
  endif()
endforeach()
if(NOT _count EQUAL 1)
  message(FATAL_ERROR "Ambiguous original NVS source registration")
endif()
set(_candidate_dir "${CMAKE_BINARY_DIR}/crux-nvs-startup-copy")
execute_process(COMMAND ${PYTHON_EXECUTABLE} "${CMAKE_CURRENT_LIST_DIR}/prepare.py"
  --zephyr "${ZEPHYR_BASE}" --output "${_candidate_dir}"
  RESULT_VARIABLE _prepare_result OUTPUT_VARIABLE _prepare_stdout ERROR_VARIABLE _prepare_stderr)
if(NOT _prepare_result EQUAL 0)
  message(FATAL_ERROR "Candidate preparation failed: ${_prepare_stdout}${_prepare_stderr}")
endif()
list(REMOVE_AT _sources ${_index})
list(APPEND _sources "${_candidate_dir}/nvs.c")
set_property(TARGET zephyr PROPERTY SOURCES "${_sources}")
target_include_directories(zephyr PRIVATE "${ZEPHYR_BASE}/subsys/kvss/nvs")
set_property(GLOBAL PROPERTY CRUX_NVS_STARTUP_REPLACED TRUE)
message(STATUS "Experimental NVS source copy selected (test-only)")
