CONFIG_CRUX_MANAGEMENT_BENCH_IMAGE=y
CONFIG_CRUX_BENCH_TEST_HOST_KEY=y
CONFIG_CRUX_BENCH_NO_TIME_SOURCE=y
CONFIG_CRUX_BENCH_FILE_RAM_DISK=y
CONFIG_CRUX_BENCH_FIRST_ACCOUNT_FILE=y
CONFIG_MAIN_STACK_SIZE=16384
CONFIG_FLASH_SIZE=8192
CONFIG_FLASH_BASE_ADDRESS=0x60000000
CONFIG_XIP=y
CONFIG_INIT_STACKS=y
CONFIG_FLASH_LOAD_OFFSET=0
# CONFIG_FLASH is not set
CONFIG_NXP_IMXRT_BOOT_HEADER=y
CONFIG_LOG=y
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=1048576
# CONFIG_BOOTLOADER_MCUBOOT is not set
CONFIG_WATCHDOG=y
CONFIG_CRUX_FILE_FATFS_RT1060_RAM_DISK=y
CONFIG_CRUX_WEB_PORT=443
CONFIG_CRUX_WEB_BIND_ADDRESS="192.168.77.2"
CONFIG_CRUX_SSH_PORT=22
CONFIG_CRUX_SSH_BIND_ADDRESS="192.168.77.2"
CONFIG_CRUX_SSH_MAX_CONNECTIONS=4
CONFIG_CRUX_SSH_STACK_REPORT=y
CONFIG_HTTP_SERVER_STACK_SIZE=8192
# CONFIG_WOLFSSL_RSA is not set
CONFIG_BOARD_REVISION="B"
CONFIG_BOARD_TARGET="mimxrt1060_evk@B/mimxrt1062/qspi"
CONFIG_MPU_STACK_GUARD=y
CONFIG_THREAD_STACK_INFO=y
CONFIG_THREAD_MONITOR=y
CONFIG_THREAD_NAME=y
CONFIG_MEM_SLAB_TRACE_MAX_UTILIZATION=y
CONFIG_DISK_DRIVER_RAM=y
# CONFIG_DISK_DRIVER_SDMMC is not set
CONFIG_ENTROPY_MCUX_TRNG=y
CONFIG_SYS_HEAP_RUNTIME_STATS=y
CONFIG_DISK_ACCESS=y
CONFIG_FILE_SYSTEM=y
# CONFIG_FS_FATFS_MOUNT_MKFS is not set
# CONFIG_NET_IPV6 is not set
CONFIG_NET_IPV4=y
CONFIG_NET_TCP_MAX_SEND_WINDOW_SIZE=5840
CONFIG_NET_TCP_MAX_RECV_WINDOW_SIZE=5840
CONFIG_NET_PKT_RX_COUNT=192
CONFIG_NET_PKT_TX_COUNT=32
CONFIG_NET_BUF_RX_COUNT=1024
CONFIG_NET_BUF_TX_COUNT=768
CONFIG_NET_STATISTICS=y
CONFIG_HTTP_SERVER_MAX_CLIENTS=3
# CONFIG_NET_DHCPV4 is not set
# CONFIG_TEST_RANDOM_GENERATOR is not set
# CONFIG_SETTINGS is not set
# CONFIG_SHELL is not set
CONFIG_SIZE_OPTIMIZATIONS=y
CONFIG_COMPILER_OPT=""
