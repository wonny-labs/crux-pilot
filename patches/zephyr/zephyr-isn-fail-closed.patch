+/* Crux: the key is read from sys_csrand_get() on first use. A failed read must not leave an all-zero key in use for
+ * the rest of the boot: it is returned, nothing is marked as read, and the next call reads again. The read goes to a
+ * local buffer, so that a failed read never leaves a partly written key in use.
+ */
+static int tcp_isn_key_get(void)
+{
+	static bool once;
+	uint8_t key[sizeof(unique_key)];
+	int ret;
+
+	if (once) {
+		return 0;
+	}
+
+	ret = sys_csrand_get(key, sizeof(key));
+	if (ret < 0) {
+		NET_ERR("Cannot read the key of the initial sequence number: %d", ret);
+		return ret;
+	}
+
+	memcpy(unique_key, key, sizeof(unique_key));
+	once = true;
+
+	return 0;
+}
