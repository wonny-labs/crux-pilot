include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CruxConsumerBoundary.cmake")

# crux::web and other channel adapters link crux_access_adapter privately, which CMake records as
# $<LINK_ONLY:crux_access_adapter>. That is part of a consumer's final link and carries no include
# directory, so a check by target name would wrongly fail every project using them. This rule asks
# the question that matters: can the adapter include directory reach the consumer's compilation?
function(_crux_access_check_directories target property)
    get_target_property(requirements "${target}" "${property}")
    if(NOT requirements OR requirements MATCHES "-NOTFOUND$")
        return()
    endif()
    set(adapter_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../components/access/adapter")
    cmake_path(NORMAL_PATH adapter_dir)
    _crux_consumer_values(values "${requirements}")
    foreach(value IN LISTS values)
        if(NOT IS_ABSOLUTE "${value}")
            continue()
        endif()
        cmake_path(IS_PREFIX adapter_dir "${value}" NORMALIZE reached)
        if(reached)
            message(FATAL_ERROR "Access adapter header reachable by a consumer: "
                                "${target} ${property}: ${value}")
        endif()
    endforeach()
endfunction()

# CMake propagates usage requirements through INTERFACE_LINK_LIBRARIES, except through LINK_ONLY.
function(_crux_access_walk target visited)
    get_target_property(real_target "${target}" ALIASED_TARGET)
    if(NOT real_target)
        set(real_target "${target}")
    endif()
    if("${real_target}" IN_LIST visited)
        set(_crux_access_visited "${visited}" PARENT_SCOPE)
        return()
    endif()
    list(APPEND visited "${real_target}")
    _crux_access_check_directories("${real_target}" INTERFACE_INCLUDE_DIRECTORIES)
    _crux_access_check_directories("${real_target}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES)
    get_target_property(libraries "${real_target}" INTERFACE_LINK_LIBRARIES)
    if(libraries AND NOT libraries MATCHES "-NOTFOUND$")
        string(REGEX REPLACE "\\$<LINK_ONLY:[^<>]*>" "" libraries "${libraries}")
        _crux_consumer_values(values "${libraries}")
        foreach(value IN LISTS values)
            if(TARGET "${value}")
                _crux_access_walk("${value}" "${visited}")
                set(visited "${_crux_access_visited}")
            endif()
        endforeach()
    endif()
    set(_crux_access_visited "${visited}" PARENT_SCOPE)
endfunction()

# Call for public targets and consumers after the composition has declared its targets.
function(crux_assert_access_adapter_unreachable)
    foreach(target IN LISTS ARGN)
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "unknown consumer target: ${target}")
        endif()
        _crux_access_walk("${target}" "")
    endforeach()
endfunction()

# A designated consumer's own PRIVATE requirements must not name the adapter either.
function(crux_assert_access_consumer)
    foreach(target IN LISTS ARGN)
        crux_assert_access_adapter_unreachable("${target}")
        get_target_property(type "${target}" TYPE)
        if(type STREQUAL "INTERFACE_LIBRARY")
            continue()
        endif()
        _crux_access_check_directories("${target}" INCLUDE_DIRECTORIES)
        get_target_property(libraries "${target}" LINK_LIBRARIES)
        if(NOT libraries OR libraries MATCHES "-NOTFOUND$")
            continue()
        endif()
        string(REGEX REPLACE "\\$<LINK_ONLY:[^<>]*>" "" libraries "${libraries}")
        _crux_consumer_values(values "${libraries}")
        foreach(value IN LISTS values)
            if(TARGET "${value}")
                _crux_access_walk("${value}" "")
            endif()
        endforeach()
    endforeach()
endfunction()
