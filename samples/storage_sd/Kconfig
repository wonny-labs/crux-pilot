mainmenu "Crux microSD composition"

config SAMPLE_SD_START
	bool "Run the microSD mount sequence at boot"
	help
	  Off by default. When on, the image initialises the SD disk and mounts the card without
	  formatting it. Physical use needs approval for the current task.

config SAMPLE_SD_FILE_CHECK
	bool "Write and verify files on the card after the mount"
	depends on SAMPLE_SD_START
	help
	  Off by default. Advances a boot counter file and verifies a fixed pattern file through
	  crux_file_*, so a restart shows what the previous boot left on the card. This WRITES to the
	  card; physical use needs approval for the current task.

config SAMPLE_SD_FILE_OPS
	bool "Create, seek in and remove a scratch file after the mount"
	depends on SAMPLE_SD_START
	help
	  Off by default. Writes a 256-byte scratch file, seeks and reads inside it, removes it and
	  checks that it is gone, all through crux_file_*. This WRITES to the card; physical use needs
	  approval for the current task.

source "Kconfig.zephyr"
