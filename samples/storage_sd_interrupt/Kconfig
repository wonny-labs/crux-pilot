mainmenu "Crux microSD interrupted-write test"

config SAMPLE_SD_INTERRUPT_TEST
	bool "Run the interrupted-write test at boot"
	help
	  Off by default. When on, the image mounts the card without formatting it, reports what the
	  previous boot's run file holds, then appends and syncs records until power is cut. This WRITES
	  to the card and is meant to be interrupted; physical use needs approval for the current task.

source "Kconfig.zephyr"
